# Local stack settings. `make db-up` copies this file to infra/local/.env on first run.
# These are LOCAL-ONLY placeholder passwords for a loopback-bound container.
# Shared environments read their credentials from the secret manager, never from a file.

# Must stay a loopback host: make db-reset refuses anything else.
CC_DB_HOST=127.0.0.1
# Host port, from the project registry (5432/5433 are taken by other local stacks).
CC_DB_PORT=5434
CC_DB_NAME=control_contable

# Bootstrap superuser (init scripts and role checks only; the app never uses it).
POSTGRES_PASSWORD=local-postgres-change-me

CC_OWNER_PASSWORD=local-cc-owner-change-me
CC_APP_PASSWORD=local-cc-app-change-me
CC_WEBHOOK_PASSWORD=local-cc-webhook-change-me
CC_WORKER_PASSWORD=local-cc-worker-change-me
