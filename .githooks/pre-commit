#!/usr/bin/env bash
# Blocks commits that contain anything resembling a secret, before it ever reaches GitHub
# (GitGuardian alerts on push are too late: the value is already public).
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks). Refusing to commit unscanned." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
